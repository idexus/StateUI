{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test StateUI",
      "type": "shell",
      "command": "swift",
      "args": ["test", "--package-path", "${workspaceFolder}"],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Test StateUI.AppKit",
      "type": "shell",
      "command": "swift",
      "args": ["test", "--package-path", "${workspaceFolder}/lib/StateUI.AppKit"],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Test Gallery",
      "type": "shell",
      "command": "swift",
      "args": ["test", "--package-path", "${workspaceFolder}/apps/Gallery"],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Test native",
      "type": "shell",
      "command": "${workspaceFolder}/.scripts/test-native.sh",
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build Gallery (AppKit, Debug)",
      "type": "shell",
      "command": "${workspaceFolder}/.scripts/build-gallery-appkit.sh",
      "args": ["debug"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build Gallery (AppKit, Release)",
      "type": "shell",
      "command": "${workspaceFolder}/.scripts/build-gallery-appkit.sh",
      "args": ["release"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build HelloWorld (AppKit, Debug)",
      "type": "shell",
      "command": "swift",
      "args": [
        "build",
        "--package-path",
        "${workspaceFolder}/apps/HelloWorld",
        "--configuration",
        "debug",
        "--product",
        "HelloWorldAppKit"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build HelloWorld (AppKit, Release)",
      "type": "shell",
      "command": "swift",
      "args": [
        "build",
        "--package-path",
        "${workspaceFolder}/apps/HelloWorld",
        "--configuration",
        "release",
        "--product",
        "HelloWorldAppKit"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
