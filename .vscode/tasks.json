{
  // Tests and builds, for running by hand. The launches are the StateUI
  // extension's "StateUI: Debug" and "StateUI: Release", which build the same
  // way these do.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test StateUI",
      "type": "shell",
      "command": "swift",
      "args": ["test", "--package-path", "${workspaceFolder}"],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Test StateUI.AppKit",
      "type": "shell",
      "command": "swift",
      "args": ["test", "--package-path", "${workspaceFolder}/lib/StateUI/StateUI.AppKit"],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Test Gallery",
      "type": "shell",
      "command": "swift",
      "args": ["test", "--package-path", "${workspaceFolder}/apps/Gallery"],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Test portable",
      "type": "shell",
      "command": "stateui",
      "args": ["repo", "test", "--plan", "portable"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Test native",
      "type": "shell",
      "command": "stateui",
      "args": ["repo", "test", "--plan", "native"],
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build Gallery (AppKit, Debug)",
      "type": "shell",
      "command": "stateui",
      "args": ["build", "--project", "${workspaceFolder}/apps/Gallery", "--host", "appkit", "--configuration", "debug"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build Gallery (AppKit, Release)",
      "type": "shell",
      "command": "stateui",
      "args": ["build", "--project", "${workspaceFolder}/apps/Gallery", "--host", "appkit", "--configuration", "release"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build HelloWorld (AppKit, Debug)",
      "type": "shell",
      "command": "stateui",
      "args": ["build", "--project", "${workspaceFolder}/apps/HelloWorld", "--host", "appkit", "--configuration", "debug"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Build HelloWorld (AppKit, Release)",
      "type": "shell",
      "command": "stateui",
      "args": ["build", "--project", "${workspaceFolder}/apps/HelloWorld", "--host", "appkit", "--configuration", "release"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
