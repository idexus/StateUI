{
  // SourceKit resolves imports through SwiftPM manifests, and this repository
  // has several: the library at the root, the AppKit host, one per app.
  "swift.searchSubfoldersForPackages": true,
  "swift.autoGenerateLaunchConfigurations": false,

  // EXCEPT THE TEMPLATE'S. lib/StateUI.Maui/Template/templates/StateUIStarter
  // is a real application with a real Package.swift, and it is CONTENT here:
  // `dotnet new` writes it out somewhere else. Found by the search above, the
  // extension would resolve a second copy of the library for a package
  // nothing in this workspace builds. Matched by directory BASENAME, and a
  // value here REPLACES the defaults, so they are repeated.
  "swift.ignoreSearchingForPackagesInSubfolders": [
    ".",
    ".build",
    "Packages",
    "out",
    "bazel-out",
    "bazel-bin",
    "StateUIStarter"
  ],
  "swift.excludePathsFromActivation": {
    "**/Template/templates/**": true
  },

  // AN APPLICATION'S AppKit HEAD IS DECLARED ONLY FOR AN APPKIT BUILD - the
  // target, its product and the StateUIAppKit dependency - so that `swift
  // test` neither resolves that package nor compiles a folder belonging to one
  // host, and it defines APPKIT only then. See apps/Gallery/Package.swift. The
  // build script sets this for itself; set here, the language server resolves
  // Platforms/AppKit and completes the code inside `#if APPKIT`. It is read
  // when the server starts, so a change asks for the window to reload.
  "swift.swiftEnvironmentVariables": {
    "STATEUI_APPKIT": "1"
  },

  // WITHOUT THIS, "Launch app (Release)" BUILDS DEBUG: the MAUI extension
  // replaces a launch's "configuration" with its own active one unless this
  // says launch.json is to be believed. Window-scoped, so the repository can
  // decide it.
  "maui.configuration.useLaunchJsonConfigurations": true,

  // The solution the C# extension and ".NET MAUI: Select Startup Project" read.
  "dotnet.defaultSolution": "StateUI.slnx",

  "files.associations": {
    "*.swift": "swift"
  },
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.build": true
  }
}
