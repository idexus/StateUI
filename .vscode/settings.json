{
  // SourceKit resolves imports through SwiftPM manifests, and this repository
  // has several: the library at the root, each host, each application and each
  // application's head. The editor's host is chosen in the StateUI extension's
  // status bar (editors/VSCode), which writes the packages' own
  // .sourcekit-lsp/config.json.
  "swift.searchSubfoldersForPackages": true,
  "swift.autoGenerateLaunchConfigurations": false,

  "files.associations": {
    "*.swift": "swift"
  },
  "files.exclude": {
    "**/bin": true,
    "**/obj": true,
    "**/.build": true
  }
}
