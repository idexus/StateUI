<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Stated, not assumed: a DEBUG build gets INTERNET injected by the .NET
       Android SDK for the debugger's sake, so leaving it out works in every
       test and fails only in Release - a WebView showing a blank page with
       nothing reported anywhere. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:allowBackup="true"
               android:icon="@mipmap/stateui_bkg"
               android:supportsRtl="true"></application>
  <!-- No uses-sdk element on purpose: the .NET Android SDK generates it from
       SupportedOSPlatformVersion and TargetPlatformVersion, keeping the two in
       sync instead of drifting apart on every SDK update (warning XA4211). -->
</manifest>
