{
  // Debugging a StateUI app.
  //
  //   Any platform, C# only          -> "Debug app (C#)"
  //   Any platform, Release build    -> "Launch app (Release)"
  //   iOS Simulator or Windows, Swift-> "Debug app (Swift)"
  //   Linux, C#                      -> "Debug app (Linux)"
  //   Linux, Swift                   -> "Debug app (Swift, Linux)"
  //   Mac Catalyst, C# + Swift       -> "Debug app (C# + Swift, Mac Catalyst)"
  //   Windows, C# + Swift at once    -> Visual Studio, not VS Code
  //   Device or Android, Swift       -> not supported
  //
  // LINUX REACHES NONE OF THE FIRST THREE, and neither miss is an omission.
  // "Debug app (C#)" and "Launch app (Release)" are the MAUI extension's type,
  // and that extension wants a workload, a device picker and a platform head:
  // Linux has none of them, MAUI arriving as an ordinary package with the head
  // a plain net10.0 executable. So its C# launch is an ordinary coreclr one,
  // and its Swift launch LAUNCHES where the others attach - for a reason the
  // kernel decides, written out on the entry itself.
  //
  // THE PICKER LISTS THEM IN THAT ORDER, widest first: "Debug app (C#)" runs on
  // every platform and every device, so it is what F5 offers before anything is
  // chosen, and the Mac Catalyst compound is the narrowest. What decides that is
  // `presentation.order` on each entry, NOT the order they appear in this file.
  //
  // Swift debugging needs the process to be reachable by LLDB ON THIS MACHINE.
  // Mac Catalyst, the iOS Simulator and Windows all qualify - each runs the app
  // as an ordinary local process. A physical device or an Android emulator does
  // not: that would need lldb-server deployed there and a port forward.
  //
  // Windows gives a process ONE native debugger, and VS Code runs the two
  // languages as two independent adapters - so the compound below works on Mac
  // Catalyst and not there. Visual Studio does both at once because it is one
  // debugger in mixed mode; it needs SwiftDebugFormat=codeview in the .csproj,
  // since it reads CodeView and LLDB reads DWARF.
  //
  // LLDB matches process names on Windows WITH the .exe extension, which is why
  // the attach configurations carry a "windows" block.
  "version": "0.2.0",
  "configurations": [
    {
      // Names no project and no device, which is what makes it follow the
      // pickers - the device or simulator in the status bar, and the startup
      // project if this workspace ever holds more than one. The Swift side is
      // compiled for whatever is chosen, by .scripts/StateUI.targets, as part
      // of the same build.
      //
      // "type": "maui", NOT "dotnet": the C# launch type declares projectPath as
      // required, so a configuration of that type is pinned to one project
      // however the pickers are set.
      "name": "Debug app (C#)",
      "type": "maui",
      "request": "launch",
      "presentation": { "group": "1 app", "order": 1 }
    },
    {
      // The same launch against the RELEASE build. The pickers still apply
      // and the Swift side is compiled with -O by the same targets; what this
      // is for is seeing what would ship.
      //
      // NOT FOR BREAKPOINTS: optimized code binds few of them, and an Android
      // Release APK is not debuggable at all.
      //
      // The "configuration" field is read only while settings.json keeps
      // "maui.configuration.useLaunchJsonConfigurations" on - without that the
      // MAUI extension replaces it with its own active configuration and
      // quietly builds Debug.
      //
      // ON WINDOWS THE PROGRAM IS SPELLED OUT, because the extension works out
      // the build and the path to the executable in two different places and
      // only the first reads the configuration: the build task appends
      // "-p:Configuration=Release", while the path comes from a second dotnet
      // of the extension's own - "build -t:_GetTargetPath -f:<tfm> …" - with no
      // Configuration at all. MSBuild defaults to Debug, so a launch that BUILT
      // Release is pointed at bin/Debug and stops with "program … does not
      // exist" before the app starts. Measured on extension 1.16.88. An
      // explicit "program" is honoured and nothing on this side can fix the
      // probe, which never says which configuration it wants.
      //
      // The path carries no architecture: the .csproj sets
      // AppendRuntimeIdentifierToOutputPath to false for Windows, so the
      // executable is not under a win-arm64 or win-x64 folder that only the
      // machine generating this app knows the name of.
      "name": "Launch app (Release)",
      "type": "maui",
      "request": "launch",
      "configuration": "Release",
      "windows": {
        "program": "${workspaceFolder}/bin/Release/net10.0-windows10.0.19041.0/StateUIStarter.exe"
      },
      "presentation": { "group": "1 app", "order": 2 }
    },
    {
      // Builds, launches WITHOUT a debugger, waits for the process, then
      // attaches LLDB to it.
      //
      // Launch-first is what makes Swift debugging work on the iOS Simulator:
      // attaching stops the app, iOS treats a stopped app as unresponsive, and
      // the watchdog kills it with signal 9. With the app already running and
      // settled, the attach is brief enough to survive.
      //
      // The app is STOPPED when this connects - press Continue (F5), and
      // breakpoints in .swift files work from there. Do not add --continue to
      // the attach command: lldb-dap expects the process to be stopped when
      // attachCommands finish, and resuming mid-handshake loses the breakpoints.
      "name": "Debug app (Swift)",
      "type": "lldb-dap",
      "request": "attach",
      "stopOnEntry": false,
      "preLaunchTask": "Run app (no debugger)",
      "attachCommands": [
        "process attach --name StateUIStarter"
      ],
      "windows": {
        "attachCommands": [
          "process attach --name StateUIStarter.exe"
        ]
      },
      "presentation": { "group": "1 app", "order": 3 }
    },
    {
      // LINUX'S F5 - the C# side, which is what the other platforms get from
      // "Debug app (C#)" and this one cannot.
      //
      // WHY IT IS A SEPARATE ENTRY. That configuration is "type": "maui", and
      // the MAUI extension is what reads it: it looks for the workload, the
      // device picker and a platform head, none of which exists here. The Linux
      // head is a PLAIN net10.0 executable - the .csproj says so, because there
      // is no workload to ask for - so an ordinary coreclr launch is exactly
      // right, and it is the only kind that works on this platform.
      //
      // The preLaunchTask is the build a reader would type, `dotnet build -c
      // Debug`. It compiles the Swift side too - StateUI.targets runs
      // build-linux.sh from inside it - so one keystroke covers both halves.
      //
      // The path carries no runtime identifier: a Linux build writes
      // bin/<config>/net10.0/, and nothing under a linux-arm64 or linux-x64
      // folder whose name only the host would know.
      //
      // cwd IS THE OUTPUT DIRECTORY, and that is not tidiness. The Swift
      // runtime ships beside the executable - a Linux desktop has none of its
      // own - and the modules find it through an $ORIGIN rpath, resolved
      // against the library's own directory. The app also reads its artwork
      // from AppContext.BaseDirectory, and this keeps the two the same place.
      "name": "Debug app (Linux)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build app (Linux)",
      "program": "${workspaceFolder}/bin/Debug/net10.0/StateUIStarter",
      "args": [],
      "cwd": "${workspaceFolder}/bin/Debug/net10.0",
      "console": "internalConsole",
      "stopAtEntry": false,
      "presentation": { "group": "1 app", "order": 6 }
    },
    {
      // THE SWIFT SIDE ON LINUX, AND IT LAUNCHES RATHER THAN ATTACHES.
      //
      // Every other platform attaches: the task starts the app, lldb-dap finds
      // it by name. That cannot work here, and the reason is the kernel's
      // rather than this project's. Ubuntu and Debian ship Yama with
      // `kernel.yama.ptrace_scope = 1`, which allows ptrace only from a
      // process's own ANCESTOR - and a debugger VS Code spawned is a SIBLING of
      // an app a task started:
      //
      //   error: attach failed: The current value of ptrace_scope is 1, which
      //   can cause ptrace to fail to attach to a running process.
      //
      // `sudo sysctl -w kernel.yama.ptrace_scope=0` lifts it, and asking for a
      // machine-wide security setting to be turned off is not what a debug
      // button should need. Launching instead makes lldb the app's own parent,
      // which Yama permits at its default.
      //
      // ONE DEBUGGER, and it is the Swift one: this is lldb-dap launching the
      // executable, so C# breakpoints do not bind in this session. Take
      // "Debug app (Linux)" for those.
      "name": "Debug app (Swift, Linux)",
      "type": "lldb-dap",
      "request": "launch",
      "preLaunchTask": "Build app (Linux)",
      "program": "${workspaceFolder}/bin/Debug/net10.0/StateUIStarter",
      "cwd": "${workspaceFolder}/bin/Debug/net10.0",
      "stopOnEntry": false,
      "presentation": { "group": "1 app", "order": 7 }
    },
    {
      // The Swift half of the compound below: attaches to an app the C# session
      // has just started. Attaches BY NAME because a compound has no PID to pass
      // between its sessions.
      //
      // THE preLaunchTask IS NOT OPTIONAL. A compound starts both its sessions
      // at once, so without it this one looks for a process the C# session has
      // not launched yet - it is still building - and `process attach --name`
      // fails immediately. What that looks like is the compound coming up with
      // only the C# debugger in it: "the Swift debugger does not attach",
      // rather than anything about a race. Selecting this configuration ON ITS
      // OWN against an app already running works either way, which is what
      // makes the difference easy to miss.
      "name": "Attach Swift debugger",
      "type": "lldb-dap",
      "request": "attach",
      "stopOnEntry": false,
      "preLaunchTask": "Wait for app startup",
      "attachCommands": [
        "process attach --name StateUIStarter"
      ],
      "windows": {
        "attachCommands": [
          "process attach --name StateUIStarter.exe"
        ]
      },
      "presentation": { "group": "1 app", "order": 5 }
    }
  ],
  "compounds": [
    {
      // Both debuggers against one process: C# starts the app, Swift attaches.
      //
      // The ORDER matters - macOS grants execution control to one debugger at a
      // time, so the second to arrive can attach successfully and still never
      // stop at a breakpoint. Launching with C# and attaching Swift afterwards
      // is the combination that works.
      //
      // MAC CATALYST. Not Windows (one native debugger per process), and
      // unreliable on the iOS Simulator (the watchdog, see above) - use
      // "Debug app (Swift)" for both of those.
      "name": "Debug app (C# + Swift, Mac Catalyst)",
      "configurations": [
        "Debug app (C#)",
        "Attach Swift debugger"
      ],
      "stopAll": true,
      "presentation": { "group": "1 app", "order": 4 }
    }
  ]
}
