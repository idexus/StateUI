<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0, no platform. MAUI's controls are ordinary managed
         objects: a Label, a Grid or a Shell can be built, configured and
         inspected without a device or a handler underneath, which is exactly
         what the renderer does to them. So these run under `dotnet test` like
         any other unit tests. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Not on Linux: UseMaui asks the SDK for the MAUI workload, which does
         not exist there. MAUI still arrives - as the package reference below -
         and the workload's implicit usings are stated as Using items, the
         same answer the runtime's own csproj gives. -->
    <UseMaui Condition="!$([MSBuild]::IsOSPlatform('linux'))">true</UseMaui>
    <SingleProject Condition="!$([MSBuild]::IsOSPlatform('linux'))">true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 10.0.20 everywhere but Linux, where the runtime's Linux head already
         references 10.0.100 - two direct pins would fight over the graph. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" Condition="!$([MSBuild]::IsOSPlatform('linux'))" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" Condition="$([MSBuild]::IsOSPlatform('linux'))" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('linux'))">
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Accessibility" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <Using Include="Microsoft.Maui.ApplicationModel.Communication" />
    <Using Include="Microsoft.Maui.ApplicationModel.DataTransfer" />
    <Using Include="Microsoft.Maui.Authentication" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Controls.Hosting" />
    <Using Include="Microsoft.Maui.Devices" />
    <Using Include="Microsoft.Maui.Devices.Sensors" />
    <Using Include="Microsoft.Maui.Graphics" />
    <Using Include="Microsoft.Maui.Hosting" />
    <Using Include="Microsoft.Maui.Media" />
    <Using Include="Microsoft.Maui.Networking" />
    <Using Include="Microsoft.Maui.Storage" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../StateUI.Runtime/StateUI.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
