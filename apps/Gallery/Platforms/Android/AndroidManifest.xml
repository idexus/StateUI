<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Stated, not assumed: a DEBUG build gets INTERNET injected by the .NET
       Android SDK for the debugger's sake, so leaving it out works in every
       test and fails only in Release - a WebView showing a blank page with
       nothing reported anywhere. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- The Your-own-acts sample asks Battery.Default, and MAUI's Battery
       checks that this permission is DECLARED before answering - it is never
       requested at runtime, the sticky broadcast behind ChargeLevel needs no
       grant. Without the line the registered act throws "You need to declare
       using the permission: android.permission.BATTERY_STATS" - reported,
       never silent, which is the failure path working as designed. Measured
       on a CPH2363 2026-08-10. -->
  <uses-permission android:name="android.permission.BATTERY_STATS" />
  <!-- The Hearing-from-C# sample subscribes to Connectivity.ConnectivityChanged,
       and MAUI's Connectivity needs this DECLARED to read the network state -
       a normal permission, granted at install, never requested at runtime. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- The WebView sample is a browser, and the web still has http in it:
       Android blocks cleartext by default (targetSdk 28+), so following a
       plain-http link inside the sample fails with ERR_CLEARTEXT_NOT_PERMITTED
       - reported from a device 2026-08-07. This says the demo may show such a
       page; the iOS half of the same statement is NSAllowsArbitraryLoadsInWebContent
       in Platforms/iOS/Info.plist. -->
  <application android:allowBackup="true"
               android:usesCleartextTraffic="true"
               android:icon="@mipmap/appicon_bkg"
               android:supportsRtl="true">
    <!-- WHAT THE APP COSTS CAN BE MEASURED IN RELEASE. Android profiles a
         RELEASE build only where the manifest says it may, and Release is the
         build worth measuring: a Debug one runs its managed code through
         Mono's interpreter and turns CheckJNI on, which multiplies every call
         into the platform and reads as a cost the reader never pays.
         Shell-only, so the permission is `adb`'s and no application on the
         device gains anything; Android 10 and later, and nothing at runtime
         depends on it. -->
    <profileable android:shell="true" />
    <!-- Google Maps draws the Map control on Android and refuses to without a
         key: with the meta-data ABSENT the page crashes on arrival, with an
         empty value it shows a grey grid with the pins on it. Put a real key
         here to see tiles:
         https://developers.google.com/maps/documentation/android-sdk/get-api-key -->
    <meta-data android:name="com.google.android.geo.API_KEY" android:value="" />
  </application>
  <!-- No uses-sdk element on purpose: the .NET Android SDK generates it from
       SupportedOSPlatformVersion and TargetPlatformVersion, keeping the two in
       sync instead of drifting apart on every SDK update (warning XA4211). -->
</manifest>
