<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target frameworks follow the host OS: iOS and Mac Catalyst need macOS
         with Xcode, the Windows head needs Windows, and Linux - which has no
         MAUI workload at all - builds a plain net10.0 executable drawn by
         MAUI's GTK4 backend. Listing only what the host can build keeps the
         output clean -
         Visual Studio aggregates warnings from every target framework into one
         Error List, so unbuildable targets would show up as noise. -->
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows')) And !$([MSBuild]::IsOSPlatform('linux'))">net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <!-- Not on Linux: UseMaui asks the SDK for the MAUI workload, which does
         not exist there. The Linux head is a plain net10.0 project that
         references MAUI as ordinary packages, and the implicit usings the
         workload would have injected are stated as Using items below. -->
    <UseMaui Condition="!$([MSBuild]::IsOSPlatform('linux'))">true</UseMaui>
    <SingleProject Condition="!$([MSBuild]::IsOSPlatform('linux'))">true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The artwork items below are this project's own, one set for all five
         platforms. The GTK4 backend would otherwise add a second copy of
         everything under Resources/ by wildcard, which is a duplicate-item
         error rather than a merge. -->
    <EnableDefaultMauiResourceItems Condition="$([MSBuild]::IsOSPlatform('linux'))">false</EnableDefaultMauiResourceItems>

    <RootNamespace>Gallery</RootNamespace>

    <!-- The title matches the project name, so the app bundle, the process and
         the project are all called Gallery. An application never takes the
         LIBRARY's name: a StateUI.app holding a Gallery executable reads as if
         the library were the application - and the PROCESS run-app.sh waits
         for is named after the project, not after the title. -->
    <ApplicationTitle>Gallery</ApplicationTitle>
    <ApplicationId>com.example.gallery</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">28.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

 <!-- iOS is the one platform whose DEFAULT runtime identifier is not the one
       you end up running on. A plain build of net10.0-ios targets the SIMULATOR,
       so every ordinary restore writes a simulator target and no ios-arm64 one -
       and the first build for a real device then fails in the SDK, before
       compiling anything:

         NETSDK1047: Assets file ... doesn't have a target for
         'net10.0-ios/ios-arm64'

       Named here so that restore produces all three, which is what makes a
       device build work from a clean tree and switching between device and
       simulator need no restore of its own.

       ONLY DURING RESTORE, which is what $(MSBuildRestoreSessionId) says. The
       iOS SDK reads RuntimeIdentifiers as "build all of these at once" and
       refuses a list mixing device and simulator - "they represent different
       platform variations" - so leaving it set for the build trades one failure
       for another. Measured, both ways round.

       No other platform needs this: theirs already default to what they run
       on. -->
  <PropertyGroup Condition="'$(MSBuildRestoreSessionId)' != '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <RuntimeIdentifiers>ios-arm64;iossimulator-arm64;iossimulator-x64</RuntimeIdentifiers>
  </PropertyGroup>
  
  <!-- Windows: unpackaged and self-contained.
       Running straight from the output folder makes native interop far easier
       to reason about - the Swift library and its runtime simply sit next to the
       .exe, with no packaging payload that might leave them out. It also allows
       launching the .exe directly, which is what lets a debugger start the app
       rather than attach to it. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Default to the HOST architecture. Hardcoding win-x64 breaks on ARM64
         machines: the app would be x64 while swiftc builds for the host, and
         loading the library fails with BadImageFormatException. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>

    <!-- AND THE RID STAYS OUT OF THE OUTPUT PATH, so the executable is
         somewhere that can be written down: bin/<config>/<framework>/<Name>.exe
         on every machine, rather than under a win-arm64 or win-x64 folder that
         only the host knows the name of. The VS Code Release launch needs a
         LITERAL path - the MAUI extension computes its own without the
         configuration and points at Debug, see .vscode/launch.json - and a
         literal path with an architecture in it is right on one machine and
         wrong on the next. Nothing else reads the layout: run-app.ps1 searches
         recursively, and the Swift payload is copied to $(OutDir), wherever
         that turns out to be. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- WHICH DEBUGGER READS THE SWIFT SIDE. Windows only; the other platforms
         have one answer and no switch.

         Left unset, the Swift library is built with DWARF, which is what LLDB
         reads - and so what VS Code reads through lldb-dap. Uncomment to build
         a .pdb in CodeView instead, which is the only thing VISUAL STUDIO can
         step through. It is one or the other, never both.

         For a single build, leave this alone and pass it on the command line:
             dotnet build -f net10.0-windows10.0.19041.0 -p:SwiftDebugFormat=codeview -->
    <!-- <SwiftDebugFormat>codeview</SwiftDebugFormat> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" Condition="!$([MSBuild]::IsOSPlatform('linux'))" />
  </ItemGroup>

  <!-- The Linux head's rendering stack, in ONE reference: StateUI.Linux hosts
       the app over Microsoft's own GTK4 backend from dotnet/maui-labs, brings
       that backend and its Essentials along as ordinary dependencies, and
       answers the gaps it leaves. `builder.UseStateUIApp<App>()` in MauiProgram
       is what starts it - the same sentence every other head writes.

       The backend it brings DEFINES LINUX and LINUX_GTK, which is why nothing
       here does, and it needs GTK 4.12+ on the machine (libgtk-4-1 and the
       gobject-introspection typelibs). -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('linux'))">
    <ProjectReference Include="../../src/StateUI.Runtime.Linux/StateUI.Runtime.Linux.csproj" />
  </ItemGroup>

  <!-- What the MAUI workload injects as implicit usings, stated by hand for
       the head that builds without it - Host/ compiles unchanged either way. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('linux'))">
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Accessibility" />
    <Using Include="Microsoft.Maui.ApplicationModel" />
    <Using Include="Microsoft.Maui.ApplicationModel.Communication" />
    <Using Include="Microsoft.Maui.ApplicationModel.DataTransfer" />
    <Using Include="Microsoft.Maui.Authentication" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Controls.Hosting" />
    <Using Include="Microsoft.Maui.Devices" />
    <Using Include="Microsoft.Maui.Devices.Sensors" />
    <Using Include="Microsoft.Maui.Graphics" />
    <Using Include="Microsoft.Maui.Hosting" />
    <Using Include="Microsoft.Maui.Media" />
    <Using Include="Microsoft.Maui.Networking" />
    <Using Include="Microsoft.Maui.Storage" />
  </ItemGroup>

  <!-- LINUX SHIPS THE VECTORS UNDER THE NAMES THE OTHER PLATFORMS RASTERIZE
       THEM TO. There is no Resizetizer here, so nothing turns `nav_home.svg`
       into `nav_home.png` - and `nav_home.png` is what every source in Swift/
       asks for, that being the name MAUI gives an SVG everywhere else. The
       backend resolves a file source by looking for exactly that name beside
       the executable, so the vectors are copied there under it.

       A vector in a file called .png is not the sleight of hand it looks like:
       GTK reads a picture by its CONTENT and not by its name - the SVG loader
       claims a file beginning `<svg` - so what arrives is the vector, drawn at
       whatever size the layout gives it. It is also the flat layout the backend
       itself uses for MauiImage, which is why the folder is not kept. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('linux'))">
    <ContentWithTargetPath Include="Resources/Images/*.svg">
      <TargetPath>%(Filename).png</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ContentWithTargetPath>

    <!-- AND THE APP ICON, where an icon theme keeps one. Nothing composes the
         two halves of MauiIcon here, so the ready-made tile is what the windows
         wear - StateUI.Linux adds this directory to the theme's search path and
         makes `appicon` every window's default.

         THE SAME VECTOR UNDER FOUR SIZES, because GTK publishes a window icon
         at the sizes its theme HAS: with the scalable entry alone the desktop
         is handed 48 pixels and scales them up for a dock or a switcher.
         Measured: scalable alone published 48x48; the sized entries publish
         48, 64 and 128. There is no rasterizer here and none is needed - a
         sized directory holding a vector is read like any other icon. -->
    <ContentWithTargetPath Include="Resources/Images/stateui_tile.svg">
      <TargetPath>hicolor/scalable/apps/appicon.svg</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="Resources/Images/stateui_tile.svg">
      <TargetPath>hicolor/64x64/apps/appicon.svg</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="Resources/Images/stateui_tile.svg">
      <TargetPath>hicolor/128x128/apps/appicon.svg</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="Resources/Images/stateui_tile.svg">
      <TargetPath>hicolor/256x256/apps/appicon.svg</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ContentWithTargetPath>
  </ItemGroup>

  <!-- Platform folders by hand for the Linux head: without the MAUI single
       project there is nothing to pick Platforms/<name>/ by target framework,
       so the plain net10.0 head removes them all and takes back its own. The
       MAUI heads leave the Linux folder out the same way - their single
       project knows the other five names, not this one. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Platforms/**" />
    <Compile Include="Platforms/Linux/**/*.cs" />
    <!-- And the XAML with it. The GTK4 backend brings MAUI's XAML pipeline
         along, which claims every .xaml in the project - including the WinUI
         App.xaml, whose `MauiWinUIApplication` exists on no other head. -->
    <MauiXaml Remove="Platforms/**" />
    <None Remove="Platforms/**/*.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <Compile Remove="Platforms/Linux/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/StateUI.Runtime/StateUI.Runtime.csproj" />
  </ItemGroup>

  <!-- The app's own Swift UI lives in Swift/ next to this file. It is compiled
       into a separate Swift module named after the project (GalleryUI),
       which imports the StateUI library. StateUI.targets discovers the
       files, so nothing is listed here. -->

  <ItemGroup>
    <!-- The mark, on the identity gradient. Color is what a platform falls back
         to where it wants a flat one rather than the artwork - .NET's violet,
         which is the end of the gradient the mark reads on. -->
    <MauiIcon Include="Resources/AppIcon/stateui_bkg.svg" ForegroundFile="Resources/AppIcon/stateui_mark.svg" Color="#512BD4"
              Condition="!$([MSBuild]::IsOSPlatform('linux'))" />

    <!-- ANDROID SEES ONLY THE MIDDLE OF AN ICON. An adaptive icon is a 108dp
         canvas of which a launcher shows 72dp - two thirds - so the same
         artwork that reads correctly on iOS, Mac and Windows reads half again
         too big there. That is what made the mark look bigger on one device
         than another, and it is not something the SVG can answer: one file,
         two croppings. ForegroundScale is Resizetizer's own lever for it, and
         0.667 is exactly the crop, so the mark ends up filling the same 54% of
         what the reader actually sees on every platform. -->
    <MauiIcon Update="Resources/AppIcon/stateui_bkg.svg" ForegroundScale="0.667"
              Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <!-- The launch screen: the white mark on .NET's violet, which is what the
         icon is and what the navigation bar is - so the app opens INTO the
         colour it launched from rather than flashing white first.

         Color is the LIGHT theme's. MAUI's Resizetizer honours one colour and
         has no dark variant, so the dark theme is done per platform where the
         platform has a way: Android picks up
         Platforms/Android/Resources/values-night/maui_colors.xml. iOS shows
         this one in both themes - its launch screen is a generated storyboard
         with the colour written into it, and there is nothing to override
         short of writing the storyboard by hand. The mark is white either way,
         which is why one artwork serves both. -->
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#512BD4" BaseSize="128,128"
                      Condition="!$([MSBuild]::IsOSPlatform('linux'))" />

    <!-- The interface's own artwork - menu rows, tab captions, toolbar items -
         referenced from Swift by the name MAUI gives them: an SVG is rasterized
         at build time, so `tab_list.svg` is asked for as `tab_list.png` -
         exactly as it would be in XAML. BaseSize is the size one point maps to;
         the build renders the denser variants from the same vector.

         Not on Linux, where there is no Resizetizer to read them and the GTK4
         backend would only copy the vectors out under their own names - which
         nothing asks for. The item above ships them under the rasterized name
         instead. -->
    <MauiImage Include="Resources/Images/*.svg" BaseSize="24,24"
               Condition="!$([MSBuild]::IsOSPlatform('linux'))" />

    <!-- The mark is drawn far bigger than a row's icon - the home page's panel
         and the menu's header - so it is rasterized from the same vector at a
         size it will not be stretched past. Update rather than a second Include:
         the wildcard above already claimed the file, and including it twice is a
         duplicate-item error. -->
    <MauiImage Update="Resources/Images/stateui_mark.svg" BaseSize="96,96" />

    <!-- The third-party notices, carried INSIDE the application.

         A built app packages the .NET runtime, the MAUI assemblies and - on
         Android and Windows - the Swift standard library, and their licenses
         ask to travel with the copy. So the file ships rather than being left
         in the repository.

         MauiAsset rather than None or BundleResource: it is the one item type
         that lands in the package on all four platforms, and it is readable at
         run time through FileSystem.OpenAppPackageFileAsync - which is what a
         Legal screen would use. LogicalName is the name inside the package,
         since the file itself sits at the repository root and is not copied.

         Plain text with no extension, beside LICENSE: nothing renders markdown
         inside an application bundle, and a notice showing its own asterisks
         reads as a mistake.

         LICENSE AND NOTICE GO WITH IT, and not only for tidiness. An
         application built from this repository is a copy of it, and Apache 2.0
         asks a copy to carry the licence (section 4a) and to reproduce the
         attribution notices in NOTICE (section 4d). The notices file points at
         both, so shipping it alone would leave a reference to nothing. -->
    <MauiAsset Include="../../THIRD-PARTY-NOTICES" LogicalName="THIRD-PARTY-NOTICES" />
    <MauiAsset Include="../../LICENSE" LogicalName="LICENSE" />
    <MauiAsset Include="../../NOTICE" LogicalName="NOTICE" />
  </ItemGroup>

  <!-- All native build logic lives in one place, shared by any project that
       wants to embed the Swift library. -->
  <Import Project="../../.scripts/StateUI.targets" />

</Project>
