<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:label="HelloWorld"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <activity
            android:name="stateui.android.StateUIActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density">
            <!-- The library this head's Swift is built into; its JNI_OnLoad starts the host. -->
            <meta-data android:name="stateui.library" android:value="HelloWorldAndroid" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
