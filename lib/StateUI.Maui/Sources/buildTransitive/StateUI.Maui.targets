<Project>

  <!-- ======================================================================
       The StateUI build, for an application that takes StateUI.Maui as a
       package.
       ======================================================================
       NuGet imports this file into every project that references the
       package, directly or through StateUI.Maui.Linux, so such an
       application's project names no build of its own. It compiles the Swift
       library and the application's module with the scripts beside it - the
       ones this release of the library was built with, since the package and
       the repository's tag are one release.

       An application in the StateUI repository, or one built against a
       checkout, references the project rather than the package and imports
       .scripts/Maui/StateUI.targets from that checkout itself.
       ====================================================================== -->
  <Import Project="$(MSBuildThisFileDirectory)Maui/StateUI.targets" />

</Project>
