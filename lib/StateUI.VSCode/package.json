{
  "name": "stateui",
  "displayName": "StateUI",
  "description": "Build, run and debug StateUI applications on AppKit and .NET MAUI.",
  "version": "0.4.0",
  "publisher": "idexus",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/idexus/StateUI.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "extensionDependencies": [
    "swiftlang.swift-vscode"
  ],
  "main": "./out/Sources/extension.js",
  "activationEvents": [
    "workspaceContains:**/Platforms/AppKit/main.swift",
    "workspaceContains:**/Platforms/Maui/*.csproj",
    "onDebugResolve:stateui",
    "onDebugDynamicConfigurations:stateui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "stateui.selectHost",
        "title": "Select Host",
        "category": "StateUI"
      },
      {
        "command": "stateui.selectApplication",
        "title": "Select Application",
        "category": "StateUI"
      },
      {
        "command": "stateui.selectDebugger",
        "title": "Select Debugger",
        "category": "StateUI"
      },
      {
        "command": "stateui.newApplicationInApps",
        "title": "New Application in apps/",
        "category": "StateUI",
        "enablement": "stateui.hasCheckout"
      },
      {
        "command": "stateui.newApplication",
        "title": "New Application from Template",
        "category": "StateUI"
      },
      {
        "command": "stateui.runTests",
        "title": "Run Tests",
        "category": "StateUI"
      },
      {
        "command": "stateui.cleanIndex",
        "title": "Clean Index",
        "category": "StateUI"
      }
    ],
    "debuggers": [
      {
        "type": "stateui",
        "label": "StateUI",
        "languages": [
          "swift"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "configuration": {
                "type": "string",
                "enum": [
                  "debug",
                  "release"
                ],
                "default": "debug",
                "description": "Which build to run on the host chosen in the status bar."
              },
              "application": {
                "type": "string",
                "description": "The application to run - its name, `Gallery`. The one chosen with StateUI: Select Application when absent."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "StateUI: Debug",
            "type": "stateui",
            "request": "launch",
            "configuration": "debug"
          },
          {
            "name": "StateUI: Release",
            "type": "stateui",
            "request": "launch",
            "configuration": "release"
          }
        ],
        "configurationSnippets": [
          {
            "label": "StateUI: Debug",
            "body": {
              "name": "StateUI: Debug",
              "type": "stateui",
              "request": "launch",
              "configuration": "debug"
            }
          },
          {
            "label": "StateUI: Release",
            "body": {
              "name": "StateUI: Release",
              "type": "stateui",
              "request": "launch",
              "configuration": "release"
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "stateui",
        "required": [],
        "properties": {
          "application": {
            "type": "string",
            "description": "The application whose AppKit head is built."
          },
          "configuration": {
            "type": "string",
            "enum": [
              "debug",
              "release"
            ]
          },
          "suite": {
            "type": "string",
            "description": "The test suite run."
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "stateui.newApplicationInApps",
          "when": "stateui.hasCheckout"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p . && node out/Build/bundleTemplate.js",
    "test": "npm run compile && node out/Tests/run.js",
    "package": "npm run compile && node out/Build/package.js"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "2.32.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  }
}
