<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The host reports the network to the application's views. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:label="StateUI Android host tests"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <!-- The window the conformance families show their pages in, as an application's activity does. It takes
             a change of the night mode itself: made again, it would leave the runner holding the window gone. -->
        <activity
            android:name="stateui.android.test.TestActivity"
            android:configChanges="uiMode"
            android:exported="false" />
    </application>

    <instrumentation
        android:name="stateui.android.test.StateUITestRunner"
        android:targetPackage="com.stateui.androidtests" />
</manifest>
