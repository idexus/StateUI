# Build products
bin/
obj/
artifacts/
.build/
.build-maui/
.build-appkit/

# The language server's own settings, written by the StateUI editor extension:
# the index directory of the host the editor works as.
.sourcekit-lsp/
.vs/

# Debug symbols
*.dSYM/
*.pdb

# IDE / OS
*.user
.DS_Store

# SDK evaluation leftovers MSBuild may leave beside a project.
*.SdkResolver.*.proj.Backup.tmp

# A resolve file a local build writes beside the template's manifest would pin
# every application made from it.
/lib/StateUI.Maui/Template/templates/*/Package.resolved

CLAUDE.md
CLAUDE.md.lnk
AGENTS.md
AGENTS.md.lnk
