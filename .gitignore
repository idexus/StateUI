# Build products
bin/
obj/
artifacts/
.build/
.build-maui/
.build-appkit/

# The language server's own settings, written by the StateUI editor extension:
# the index directory of the host the editor works as.
.sourcekit-lsp/
.vs/

# Debug symbols
*.dSYM/
*.pdb

# IDE / OS
*.user
.DS_Store

# SDK evaluation leftovers MSBuild may leave beside a project.
*.SdkResolver.*.proj.Backup.tmp

# The template ships the SAME build scripts the apps here use, copied in as
# StateUI.Maui.Template builds. Ignored rather than committed so the copy cannot
# go stale against .scripts/Maui/, which is the original.
/lib/StateUI.Maui/Template/templates/*/.scripts/
/lib/StateUI.Maui/Template/templates/*/Package.resolved

CLAUDE.md
CLAUDE.md.lnk
AGENTS.md
AGENTS.md.lnk
