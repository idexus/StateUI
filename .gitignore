# Build products
bin/
obj/
artifacts/
# SwiftPM's build directory, .build, which holds each host's builds as well:
# .build/appkit, .build/uikit, .build/android, .build/winui, .build/gtk.
.build*/
# What Gradle keeps beside a head an editor opens; the scripts keep theirs in .build/android.
.gradle/

# The language server's own settings, written by the StateUI editor extension:
# the index directory of the host the editor works as.
.sourcekit-lsp/
.vs/

# Debug symbols
*.dSYM/
*.pdb

# IDE / OS
*.user
.DS_Store

# The recordings the README shows travel as the mp4 beside them; the originals
# are large and stay on the machine that made them.
/docs/assets/*.mov

# A map provider's key is the application's own, never the repository's: the
# Gallery's Web head reads it from this script, made on the machine that serves it.
/apps/Gallery/Platforms/Web/Page/google-maps-key.js

# SDK evaluation leftovers MSBuild may leave beside a project.
*.SdkResolver.*.proj.Backup.tmp

CLAUDE.md
CLAUDE.md.lnk
AGENTS.md
AGENTS.md.lnk
